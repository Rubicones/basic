{
  "name": "basic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-arbitrary.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run check:notify",
    "seed": "node --experimental-strip-types scripts/generate-seed.mjs",
    "check:notify": "node --experimental-strip-types scripts/check-notify-message.ts && node --experimental-strip-types scripts/check-notify-delivery.ts && node --experimental-strip-types scripts/check-web-push.ts",
    "bundle:notify": "node scripts/bundle-notify.mjs",
    "vapid": "node scripts/vapid.mjs",
    "check:db": "bash scripts/db-test/run.sh",
    "build:restore": "node scripts/build-restore.mjs",
    "check:restore": "bash scripts/db-test/run.sh --restore"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
