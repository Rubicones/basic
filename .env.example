# Copy to .env.local and fill in. Never commit .env.local.

# Absolute origin, no trailing slash. Used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase project — Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server only. Never prefixed NEXT_PUBLIC_, never imported from a client component.
SUPABASE_SERVICE_ROLE_KEY=""

# Console demo mode. "1" fills the console with fixtures, skips sign-in and saves
# nothing — for demonstrating the interface before the data exists. Ignored in a
# production build, so a forgotten flag cannot publish an open console.
NEXT_PUBLIC_CONSOLE_DEMO="0"

# Catalogue demo photography. "1" renders the reference's six pictures in place of
# the shop's own, cycled across the catalogue. Photographs only — unlike the console
# flag it changes nothing else, so it is allowed in a production build.
NEXT_PUBLIC_CATALOG_DEMO_PHOTOS="0"
